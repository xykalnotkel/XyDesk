# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Credential/provider — JANGAN pernah di-commit ──
**/*firebase-adminsdk*.json
android/app/google-services.json

# ── Penandatanganan — JANGAN pernah di-commit ──
android/key.properties
android/app/*.jks
android/app/*.keystore
*.p12
*.mobileprovision
ios/Runner/GoogleService-Info.plist

# Folder platform dan output deploy dibuat ulang oleh CI.
# CATATAN: /web/ TIDAK diabaikan lagi — sejak client Vite+React, web/ adalah
# source asli (bukan hasil generate flutter create).
/windows/
/linux/
/macos/
/ios/
/web_deploy/site/
.flutter-plugins

# ── Artefak tooling yang pernah ter-commit tanpa sengaja ──
# `.wrangler/` adalah state + cache lokal Miniflare (sqlite) milik wrangler dev.
# 10 berkas biner sempat masuk git; isinya berbeda di setiap mesin dan tidak
# pernah dibaca CI (deploy memakai `web_deploy/site/` hasil build).
.wrangler/
**/.wrangler/

# Info build inkremental TypeScript. Sempat ter-commit dan berubah setiap kali
# `tsc -b`/`npm run typecheck` dijalankan, jadi ia membuat working tree kotor
# hanya karena seseorang memeriksa kode.
*.tsbuildinfo

# Output build web — CI mengunggahnya sebagai artefak, bukan dari git.
/web/dist/

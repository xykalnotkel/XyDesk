/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self' https://signal.xydesk.my.id wss://signal.xydesk.my.id https://news.xydesk.my.id; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self' https://accounts.google.com

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

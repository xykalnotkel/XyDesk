{
  "name": "xydesk-desktop",
  "version": "6.8.5",
  "private": true,
  "type": "module",
  "description": "XyDesk Desktop — shell Tauri + Next.js untuk host Windows. Engine streaming (capture/encode/WebRTC) tetap Rust di xydesk-host.exe; proses ini tidak menangani media.",
  "author": "XyStudio",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3470",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/desktop.test.js",
    "tauri:dev": "cargo tauri dev --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  }
}

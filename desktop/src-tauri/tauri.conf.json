{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XyDesk",
  "version": "6.7.12",
  "identifier": "com.xydesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3470",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "XyDesk",
        "width": 1100,
        "height": 680,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#fafaf9",
        "shadow": true
      }
    ],
    "trayIcon": {
      "id": "xydesk-tray",
      "iconPath": "icons/tray.ico",
      "iconAsTemplate": true,
      "tooltip": "XyDesk Host"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "autostart": {}
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XyDesk",
  "version": "2.2.1",
  "identifier": "id.my.xystudio.xydesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XyDesk",
        "width": 460,
        "height": 640,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://signal.xystudio.my.id ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
